        "owner": "sidor0912",
        "repo": "FunPayCardinal",
        "rev": "90c911411b0939025d6eade4821d8de7fa96c009"
      }
    }
  },
  "user": {
    "name": "nonroot",
    "group": "nonroot",
    "uid": 65532,
    "gid": 65532
  },
  "build": {
    "env": {
      "PIP_NO_CACHE_DIR": 1,
      "PYTHONDONTWRITEBYTECODE": 1,
      "PATH": "/venv/bin:${PATH}"
