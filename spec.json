      "platform": {
        "os": "debian"
      },
      "image": {
        "repo": "docker.io/python",
        "version": "3.11-bookworm"
      }
    },
    "glibc-debian13": {
      "platform": {
        "os": "debian"
      },
      "image": {
        "repo": "docker.io/python",
        "version": "3.11-trixie"
      }
    },
    "musl": {
      "platform": {
        "os": "alpine"
      },
      "image": {
        "repo": "docker.io/python",
        "version": "3.11-alpine3.24"
      }
    }
  },
  "final": {
    "alpine": {
      "from": "musl",
      "create_user": true,
      "include": [],
      "tags": [],
      "platforms": [
        "linux/amd64",
        "linux/arm64",
        "linux/arm64/v8"
      ],
      "image": {
        "repo": "docker.io/python",
        "version": "3.11-alpine3.24"
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": 1,
        "PIP_NO_CACHE_DIR": 1,
        "PYTHONUNBUFFERED": 1,
        "PATH": "/venv/bin:${PATH}"
