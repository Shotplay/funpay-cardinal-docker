    "cleanup": {
      "paths": [
        ".git",
        ".github",
        ".gitignore",
        "README.md",
        "Cardinal.ico",
        "install-fpc.sh",
        "Dockerfile*",
        "docker-compose*.yml",
        "FunPayCardinal@.service",
        "*.bat"
      ]
    },
    "image": {
      "repo": "docker.io/alpine/git",
      "version": "2.54.0"
    }
  },
  "cardinal": {
    "version": "0.1.17.10",
    "source": {
