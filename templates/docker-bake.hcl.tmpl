{{- $tags_repo := "docker.io/shotplay/fp-cardinal" -}}
{{- $cardinal_version := .spec.cardinal.version -}}
{{- $cardinal_version_parts := strings.Split "." $cardinal_version -}}
{{- $cardinal_major := index $cardinal_version_parts 0 -}}
{{- $cardinal_minor := index $cardinal_version_parts 1 -}}
{{- $cardinal_patch := index $cardinal_version_parts 2 -}}

{{ tmpl.Exec "license" . }}

# =========================================================
# THIS FILE IS GENERATED VIA "just update-bake.
# 
# PLEASE DO NOT EDIT IT MANUALLY.
# =========================================================

group "default" {
  targets = [
    {{- range $key, $value := .spec.final }}
    "{{ $key }}",
    {{- end }}
  ]
}

group "cross" {
  targets = [
    {{- range $key, $value := .spec.final }}
    "{{ $key }}-cross",
    {{- end }}
  ]
}

variable "CARDINAL_VERSION" {
  default = "{{ $cardinal_version }}"
}

variable "CARDINAL_REVISION" {
  default = "{{ .spec.cardinal.source.github.rev }}"
}

variable "OCI_AUTHORS" {
  default = "{{ .spec.oci.authors }}"
}

variable "OCI_URL" {
  default = "{{ .spec.oci.url }}"
}

variable "OCI_SOURCE" {
  default = "{{ .spec.oci.source }}"
}

variable "OCI_TITLE" {
  default = "{{ .spec.oci.title }}"
}

variable "OCI_DESCRIPTION" {
  default = "{{ .spec.oci.description }}"
}

{{- range $key, $final := .spec.final }}

target "{{ $key }}" {
  inherits = ["_attest"]
  context = "./versions/{{ $.spec.cardinal.version }}/{{ $key }}"
  dockerfile = "Dockerfile"
  tags = [
    {{- if gt (len $final.tags) 0 }}
    {{- range $final.tags }}
    "{{ $tags_repo }}:{{ . }}",
    {{- end }}
    {{- end }}
    "{{ $tags_repo }}:latest-{{ $key }}",
    "{{ $tags_repo }}:{{ $cardinal_version }}-{{ $key }}",
    "{{ $tags_repo }}:{{ $cardinal_major }}.{{ $cardinal_minor }}.{{ $cardinal_patch }}-{{ $key }}",
    "{{ $tags_repo }}:{{ $cardinal_major }}.{{ $cardinal_minor }}-{{ $key }}",
    "{{ $tags_repo }}:{{ $cardinal_major }}-{{ $key }}",
  ]
  labels = {
    "org.opencontainers.image.version"="${CARDINAL_VERSION}"
    "org.opencontainers.image.revision"="${CARDINAL_REVISION}"
    "org.opencontainers.image.authors"="${OCI_AUTHORS}"
    "org.opencontainers.image.url"="${OCI_URL}"
    "org.opencontainers.image.source"="${OCI_SOURCE}"
    "org.opencontainers.image.title"="${OCI_TITLE}"
    "org.opencontainers.image.description"="${OCI_DESCRIPTION}"
    "org.opencontainers.image.base.name"="{{ $final.image.repo }}:{{ $final.image.version }}"
  }
  annotations = [
    "org.opencontainers.image.version=${CARDINAL_VERSION}",
    "org.opencontainers.image.revision=${CARDINAL_REVISION}",
    "org.opencontainers.image.authors=${OCI_AUTHORS}",
    "org.opencontainers.image.url=${OCI_URL}",
    "org.opencontainers.image.source=${OCI_SOURCE}",
    "org.opencontainers.image.title=${OCI_TITLE}",
    "org.opencontainers.image.description=${OCI_DESCRIPTION}",
    "org.opencontainers.image.base.name={{ $final.image.repo }}:{{ $final.image.version }}",
  ]
}
{{- end }}

{{- range $key, $final := .spec.final }}

target "{{ $key }}-cross" {
  inherits = ["{{ $key }}"]
  platforms = [
  {{- range $final.platforms }}
    "{{ . }}",
  {{- end }}
  ]
}
{{- end }}

target "_attest" {
  attest = [
    {
      type = "provenance"
      mode = "max"
    },
    {
      type = "sbom"
    }
  ]
}