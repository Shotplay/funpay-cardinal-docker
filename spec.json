        "org.opencontainers.image.base.name": "docker.io/python:3.11-slim-trixie"
      },
      "image": {
        "repo": "docker.io/python",
        "version": "3.11-slim-trixie"
      },
      "env": {
        "PYTHONDONTWRITEBYTECODE": 1,
        "PIP_NO_CACHE_DIR": 1,
        "PYTHONUNBUFFERED": 1,
        "PATH": "/venv/bin:${PATH}"
      },
      "entrypoint": [
        "python3"
      ],
      "cmd": [
        "main.py"
      ]
    },
    "distroless": {
      "from": "glibc",
      "create_user": true,
      "include": [
        {
          "from": "build",
          "dest": "/usr/local/lib/",
          "srcs": [
            "/usr/local/lib/libpython3.11.so",
            "/usr/local/lib/libpython3.11.so.1.0",
            "/usr/local/lib/libpython3.so"
          ]
        },
        {
          "from": "build",
          "dest": "/usr/local/lib/python3.11/",
          "srcs": [
            "/usr/local/lib/python3.11/"
          ]
        }
      ],
      "labels": {
        "org.opencontainers.image.authors": "shotplaymeow",
        "org.opencontainers.image.url": "https://github.com/Shotplay/funpay-cardinal-docker",
        "org.opencontainers.image.source": "https://github.com/sidor0912/FunPayCardinal",
        "org.opencontainers.image.version": "0.1.17.13",
        "org.opencontainers.image.revision": "4e62af063fab4e9164b6a8bfdb2ac387f2b0a83f",
        "org.opencontainers.image.title": "Funpay-Cardinal-Docker",
        "org.opencontainers.image.description": "Auto-generated Docker image for containerizing the FunPayCardinal bot",
        "org.opencontainers.image.base.name": "gcr.io/distroless/cc-debian13:latest"
      },
      "image": {
        "repo": "gcr.io/distroless/cc-debian13",
        "version": "latest"
      },
      "env": {
        "LD_LIBRARY_PATH": "/usr/local/lib:/usr/lib:/lib",
        "PYTHONDONTWRITEBYTECODE": 1,
        "PIP_NO_CACHE_DIR": 1,
        "PYTHONUNBUFFERED": 1,
        "PATH": "/venv/bin:${PATH}"
      },
      "entrypoint": [
        "python3"
      ],
      "cmd": [
        "main.py"
      ]
    }
